# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the real .env file to version control.

# --- n8n basic auth (login shown by n8n itself) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# --- n8n credential encryption key ---
# Generate with: openssl rand -hex 32
# IMPORTANT: back this up. If lost, saved credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output

# --- Networking ---
N8N_HOST=localhost
WEBHOOK_URL=https://localhost/
TIMEZONE=UTC
